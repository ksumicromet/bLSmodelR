# ============================================================
# 29) ESTIMAR Cb DE CH4 USANDO AS DUAS LINHAS
# ============================================================
# Método:
#   Cb = menor concentração entre as duas linhas no mesmo horário.
#
# Depois fica apenas a linha com maior concentração, interpretada
# como linha mais influenciada pela pluma naquele horário.

conc_df <- dados_modelo %>%
  select(
    TimeStamp,
    CH4_LineSensor1_ppmv,
    CH4_LineSensor2_ppmv
  ) %>%
  filter(
    !is.na(TimeStamp),
    !is.na(CH4_LineSensor1_ppmv),
    !is.na(CH4_LineSensor2_ppmv)
  ) %>%
  mutate(
    Cb_CH4_ppmv = pmin(
      CH4_LineSensor1_ppmv,
      CH4_LineSensor2_ppmv,
      na.rm = TRUE
    ),
    
    Sensor_downwind = case_when(
      CH4_LineSensor1_ppmv > CH4_LineSensor2_ppmv ~ "LineSensor1",
      CH4_LineSensor2_ppmv > CH4_LineSensor1_ppmv ~ "LineSensor2",
      TRUE ~ NA_character_
    )
  ) %>%
  pivot_longer(
    cols = c(CH4_LineSensor1_ppmv, CH4_LineSensor2_ppmv),
    names_to = "Sensor_col",
    values_to = "CH4_ppmv"
  ) %>%
  mutate(
    Sensor = case_when(
      Sensor_col == "CH4_LineSensor1_ppmv" ~ "LineSensor1",
      Sensor_col == "CH4_LineSensor2_ppmv" ~ "LineSensor2",
      TRUE ~ NA_character_
    ),
    
    CH4_delta_ppmv = CH4_ppmv - Cb_CH4_ppmv
  ) %>%
  filter(Sensor == Sensor_downwind) %>%
  select(
    TimeStamp,
    Sensor,
    CH4_ppmv,
    Cb_CH4_ppmv,
    CH4_delta_ppmv
  )

cat("\nNúmero de linhas após estimar Cb:", nrow(conc_df), "\n")

