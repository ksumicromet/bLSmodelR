ajustar_timestamp <- function(x) {
  x <- trimws(as.character(x))
  
  parse_date_time(
    x,
    orders = c(
      "mdy HMS",
      "mdy HM",
      "ymd HMS",
      "ymd HM",
      "dmy HMS",
      "dmy HM"
    ),
    tz = "America/Chicago"
  )
}


converter_numero <- function(x) {
  as.numeric(gsub(",", ".", trimws(as.character(x))))
}


