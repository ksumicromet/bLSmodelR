# ============================================================
# 33) CALCULAR EMISSÃO DE CH4
# ============================================================

MW_CH4 <- 16.04
R_gas  <- 8.314462618

Results_emission <- Results_emission %>%
  mutate(
    CH4_delta_ppmv = ifelse(CH4_delta_ppmv <= 0, NA, CH4_delta_ppmv),
    
    # Conversão ppmv para ug/m3:
    # ug/m3 = ppmv * P * MW / (R * T)
    CH4_delta_ug_m3 = CH4_delta_ppmv * P_Pa * MW_CH4 / (R_gas * T_K),
    
    # CE = C / E
    # E = C / CE
    Q_ug_m2_s = CH4_delta_ug_m3 / CE,
    
    # ug/m2/s para g/m2/dia
    Q_g_m2_day = Q_ug_m2_s * 86400 / 1E6
  )


# ============================================================
# 34) CALCULAR EMISSÃO TOTAL DA FONTE
# ============================================================

Results_emission <- Results_emission %>%
  mutate(
    SourceArea_m2 = SourceArea_m2,
    
    Q_total_ug_s = Q_ug_m2_s * SourceArea_m2,
    Q_total_mg_s = Q_total_ug_s / 1000,
    Q_total_g_s = Q_total_ug_s / 1E6,
    Q_total_kg_day = Q_total_g_s * 86400 / 1000
  )


