# ============================================================
# 37) COMPARAR EMISSÃO DO R COM EMISSÃO DO WINDTRAX
# ============================================================
# Coluna do R:
#   Q_g_m2_day
#
# Coluna do WindTrax:
#   Q_WindTrax_g_m2_day
#
# Critério:
#   remover linhas em que Q_g_m2_day seja negativo
#   OU em que Q_WindTrax_g_m2_day seja negativo.


windtrax_df <- dados_modelo %>%
  select(
    TimeStamp,
    Q_WindTrax_g_m2_day
  ) %>%
  distinct(TimeStamp, .keep_all = TRUE)

Comparacao_R_WindTrax <- Results_emission %>%
  select(
    TimeStamp,
    Sensor,
    Q_R_g_m2_day = Q_g_m2_day
  ) %>%
  inner_join(
    windtrax_df,
    by = "TimeStamp"
  ) %>%
  filter(
    !is.na(Q_R_g_m2_day),
    !is.na(Q_WindTrax_g_m2_day),
    Q_R_g_m2_day >= 0,
    Q_WindTrax_g_m2_day >= 0
  ) %>%
  arrange(TimeStamp)

cat("\nNúmero de linhas em Results_emission:", nrow(Results_emission), "\n")
cat("Número de linhas após juntar com WindTrax e remover negativos:",
    nrow(Comparacao_R_WindTrax), "\n")

cat("\nPrimeiras linhas da comparação R x WindTrax:\n")
print(head(Comparacao_R_WindTrax))


# ============================================================
# 38) ESTATÍSTICA DAS DUAS COLUNAS DE EMISSÃO
# ============================================================

Estatistica_R_WindTrax <- Comparacao_R_WindTrax %>%
  summarise(
    n = n(),
    
    R_min = min(Q_R_g_m2_day, na.rm = TRUE),
    R_Q1 = quantile(Q_R_g_m2_day, 0.25, na.rm = TRUE),
    R_mediana = median(Q_R_g_m2_day, na.rm = TRUE),
    R_media = mean(Q_R_g_m2_day, na.rm = TRUE),
    R_Q3 = quantile(Q_R_g_m2_day, 0.75, na.rm = TRUE),
    R_max = max(Q_R_g_m2_day, na.rm = TRUE),
    R_desvio_padrao = sd(Q_R_g_m2_day, na.rm = TRUE),
    
    WindTrax_min = min(Q_WindTrax_g_m2_day, na.rm = TRUE),
    WindTrax_Q1 = quantile(Q_WindTrax_g_m2_day, 0.25, na.rm = TRUE),
    WindTrax_mediana = median(Q_WindTrax_g_m2_day, na.rm = TRUE),
    WindTrax_media = mean(Q_WindTrax_g_m2_day, na.rm = TRUE),
    WindTrax_Q3 = quantile(Q_WindTrax_g_m2_day, 0.75, na.rm = TRUE),
    WindTrax_max = max(Q_WindTrax_g_m2_day, na.rm = TRUE),
    WindTrax_desvio_padrao = sd(Q_WindTrax_g_m2_day, na.rm = TRUE),
    
    diferenca_media_R_menos_WindTrax = mean(
      Q_R_g_m2_day - Q_WindTrax_g_m2_day,
      na.rm = TRUE
    ),
    
    diferenca_mediana_R_menos_WindTrax = median(
      Q_R_g_m2_day - Q_WindTrax_g_m2_day,
      na.rm = TRUE
    ),
    
    RMSE = sqrt(
      mean(
        (Q_R_g_m2_day - Q_WindTrax_g_m2_day)^2,
        na.rm = TRUE
      )
    ),
    
    correlacao_Pearson = cor(
      Q_R_g_m2_day,
      Q_WindTrax_g_m2_day,
      use = "complete.obs",
      method = "pearson"
    )
  )

cat("\nEstatística das emissões do R e do WindTrax:\n")
print(Estatistica_R_WindTrax)


# ============================================================
# 39) ORGANIZAR DADOS PARA GRÁFICO DE LINHA
